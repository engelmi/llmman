Name:		llmman
Version:	@VERSION@
Release:	@RELEASE@%{?dist}
Summary:	CLI for running, managing and distributing AI models
License:	Apache-2.0
URL:		https://github.com/llmmanorg/llmman
Source0:	%{name}-%{version}.tar.gz

BuildRequires:  cargo-rpm-macros
BuildRequires:  rust-packaging
BuildRequires:  golang >= 1.22

%description
OCI-native command-line tool for managing, distributing, and running large 
language models (LLMs) using container registries and local inference runtimes.

%prep
%autosetup

%build
cargo build --release

%install
mkdir -p %{buildroot}%{_bindir}
install -m 0755 target/release/llmman %{buildroot}%{_bindir}/llmman
install -m 0755 target/release/llmman-bench %{buildroot}%{_bindir}/llmman-bench

%files
%license LICENSE
%{_bindir}/llmman
%{_bindir}/llmman-bench

%changelog
%autochangelog
